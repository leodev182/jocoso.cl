---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Equipos gamers y periféricos al mejor precio — jocoso.cl' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg" />
    <title>{title} | jocoso.cl</title>

    <!-- Previene flash de modo claro: aplica tema antes del primer paint -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const theme = saved ?? 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <!-- Fondo animado de luces difuminadas -->
    <div class="scene" aria-hidden="true">
      <div class="scene__blob scene__blob--1"></div>
      <div class="scene__blob scene__blob--2"></div>
      <div class="scene__blob scene__blob--3"></div>
    </div>

    <Navbar />
    <main class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Compensa el header fijo (Navbar) para que el contenido no quede debajo */
  .page { padding-top: var(--header-height); }

  /* ── Fondo de luces difuminadas ── */
  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .scene__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    animation: blob-drift var(--dur, 20s) ease-in-out infinite alternate;
    transition: opacity 0.4s ease;
  }

  /* Cyan — top-left (color de marca jocoso) */
  .scene__blob--1 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, #2EE6FF, #05204A);
    top: -200px;
    left: -150px;
    --dur: 22s;
  }

  /* Naranja — bottom-right */
  .scene__blob--2 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #f97316, #fb923c);
    bottom: -200px;
    right: -100px;
    --dur: 18s;
    animation-delay: -8s;
  }

  /* Cálido amber — centro */
  .scene__blob--3 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, #f59e0b, #1CC8E5);
    top: 45%;
    left: 48%;
    --dur: 26s;
    animation-delay: -14s;
  }

  @keyframes blob-drift {
    0%   { transform: translate(0, 0) scale(1); }
    33%  { transform: translate(60px, -40px) scale(1.08); }
    66%  { transform: translate(-40px, 55px) scale(0.94); }
    100% { transform: translate(30px, 25px) scale(1.05); }
  }

  /* En light mode los blobs sobre fondo blanco */
  [data-theme="light"] .scene__blob { opacity: 0.35; }
</style>
