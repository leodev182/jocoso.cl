---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Equipos gamers y periféricos al mejor precio — jocoso.cl' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg" />
    <title>{title} | jocoso.cl</title>

    <!-- Previene flash de modo claro: aplica tema antes del primer paint -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const theme = saved ?? 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <Navbar />
    <main class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Compensa el header fijo (Navbar) para que el contenido no quede debajo */
  .page { padding-top: var(--header-height); }
</style>
