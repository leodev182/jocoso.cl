---
---

<div id="promo-modal" class="promo-overlay" role="dialog" aria-modal="true" aria-label="Gran Rifa Jocoso">
  <div class="promo-box">
    <button id="promo-close" class="promo-close" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
    <img
      src="/images/promo-rifa.jpeg"
      alt="¡Gran Rifa Jocoso! Participá y ganá un monitor gamer DarkFlash G253FG"
      class="promo-img"
    />
  </div>
</div>

<style>
  .promo-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 16px;
    transition: opacity 0.3s ease;
  }

  .promo-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .promo-box {
    position: relative;
    max-width: min(860px, 100%);
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.06);
    animation: modal-in 0.3s ease;
  }

  .promo-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .promo-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .promo-close:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: scale(1.1);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.94); }
    to   { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  const overlay = document.getElementById('promo-modal');
  const closeBtn = document.getElementById('promo-close');

  const STORAGE_KEY = 'promo_rifa_seen';

  function closeModal() {
    overlay?.classList.add('hidden');
    setTimeout(() => { if (overlay) overlay.hidden = true; }, 320);
    sessionStorage.setItem(STORAGE_KEY, '1');
  }

  // Solo una vez por sesión
  if (sessionStorage.getItem(STORAGE_KEY)) {
    if (overlay) overlay.hidden = true;
  } else {
    closeBtn?.addEventListener('click', closeModal);

    // Click fuera del box cierra el modal
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    // Escape cierra el modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    }, { once: true });
  }
</script>
