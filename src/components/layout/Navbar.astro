---
import ThemeSwitch from './ThemeSwitch.astro';
import { getStorefrontTags, isMainTag } from '../../lib/api';

const categories = (await getStorefrontTags()).filter(isMainTag);

const navLinks = [
  { label: 'Catálogo',   href: '/productos' },
  { label: 'Contacto',   href: '/contacto' },
  { label: 'Mayoristas', href: '/mayoristas' },
];
---

<header id="navbar">

  <!-- ── Barra principal ── -->
  <div class="main-bar">
    <div class="main-bar-inner">

      <!-- Logo -->
      <a href="/" class="logo">
        <span class="logo-accent">jocoso</span>.cl
      </a>

      <!-- Buscador (desktop) -->
      <div class="search-wrap">
        <div class="search-box">
          <input
            type="search"
            id="search-input"
            class="search-input"
            placeholder="Buscar productos..."
            autocomplete="off"
          />
          <button class="search-btn" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Acciones -->
      <div class="nav-actions">
        <!-- Icono de búsqueda solo en mobile -->
        <button class="icon-btn mobile-search-toggle" id="mobile-search-btn" aria-label="Buscar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>

        <ThemeSwitch />

        <a href="/cuenta" class="icon-btn" id="user-btn" aria-label="Mi cuenta">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </a>

        <a href="/carrito" class="icon-btn" id="cart-btn" aria-label="Ver carrito">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
          <span id="cart-count" class="cart-count hidden">0</span>
        </a>

        <button class="hamburger" id="hamburger" aria-label="Menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- Buscador mobile (expandible) -->
    <div class="mobile-search-bar" id="mobile-search-bar">
      <div class="search-box">
        <input type="search" class="search-input" placeholder="Buscar productos..." autocomplete="off" />
        <button class="search-btn" aria-label="Buscar">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Sub-barra de navegación ── -->
  <div class="category-bar">
    <div class="category-inner">
      <div class="cat-dropdown">
        <button class="cat-toggle" id="cat-toggle" aria-expanded="false" aria-controls="cat-panel">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          Categorías
          <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <!-- Panel desplegable: cae justo debajo del botón, sobre el hero -->
        <div class="cat-panel" id="cat-panel" hidden>
          <ul>
            <li><a href="/productos" class="cat-item all">Todos los productos</a></li>
            {categories.map((c) => (
              <li>
                <a href={`/productos?tag=${c.slug}`} class="cat-item">
                  <span class="dot" style={`--c: ${c.color}`}></span>
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <nav class="sub-links">
        {navLinks.map((link) => (
          <a href={link.href} class="cat-tag">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>

</header>

<!-- Drawer mobile -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  <div class="mobile-divider"></div>
  <a href="/cuenta">Mi cuenta</a>
</div>

<style>
  /* ── Header shell ── */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
  }

  /* ── Main bar ── */
  .main-bar {
    background: var(--bg-brand);
    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    transition: background var(--transition);
  }

  header.scrolled .main-bar {
    background: color-mix(in srgb, var(--bg-brand) 88%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .main-bar-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    height: 64px;
    padding: 0 24px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ── Logo ── */
  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.5px;
    white-space: nowrap;
  }
  .logo-accent {
    color: var(--accent);
    text-shadow: var(--neon-text);
  }

  /* ── Search ── */
  .search-wrap { flex: 1; }

  .search-box {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1.5px solid color-mix(in srgb, var(--text) 12%, transparent);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition);
    height: 40px;
  }
  .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: var(--neon-subtle);
  }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 0.88rem;
    padding: 0 14px;
    height: 100%;
    min-width: 0;
  }
  .search-input::placeholder { color: var(--text-muted); }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #0d0f14;
    border: none;
    padding: 0 14px;
    height: 100%;
    cursor: pointer;
    flex-shrink: 0;
    transition: filter var(--transition);
  }
  .search-btn:hover { filter: brightness(1.1); }

  /* ── Actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: color var(--transition), background var(--transition);
  }
  .icon-btn:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .icon-btn.user-logged {
    color: var(--accent);
    filter: drop-shadow(0 0 5px var(--accent)) drop-shadow(0 0 12px color-mix(in srgb, var(--accent) 55%, transparent));
    transition: color var(--transition), filter var(--transition), background var(--transition);
  }
  .icon-btn.user-logged:hover {
    color: var(--accent);
    filter: drop-shadow(0 0 8px var(--accent)) drop-shadow(0 0 20px var(--accent));
  }

  .cart-count {
    position: absolute;
    top: 2px; right: 2px;
    background: var(--accent);
    color: #0d0f14;
    font-size: 0.58rem;
    font-weight: 700;
    width: 15px; height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-count.hidden { display: none; }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px; height: 36px;
    padding: 7px;
    border-radius: var(--radius-sm);
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), background var(--transition);
  }
  .hamburger:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
    transform-origin: center;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile search toggle ── */
  .mobile-search-toggle { display: none; }

  .mobile-search-bar {
    display: none;
    padding: 0 16px 12px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .mobile-search-bar.open { display: block; }

  /* ── Category bar ── */
  .category-bar {
    position: relative;
    background: var(--bg);
    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  }

  .category-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 24px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .cat-dropdown {
    position: relative;
    flex-shrink: 0;
  }

  /* Botón que despliega el panel de categorías */
  .cat-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: filter var(--transition);
  }
  .cat-toggle:hover { filter: brightness(1.08); }
  .cat-toggle .chevron { transition: transform var(--transition); }
  .cat-toggle[aria-expanded='true'] .chevron { transform: rotate(180deg); }

  .sub-links {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sub-links::-webkit-scrollbar { display: none; }

  .cat-tag {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
    flex-shrink: 0;
  }
  .cat-tag:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }

  /* ── Panel desplegable de categorías ── */
  .cat-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 50;
    width: 260px;
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    padding: 8px;
    transform-origin: top;
    animation: cat-drop 160ms ease;
  }
  .cat-panel[hidden] { display: none; }
  .cat-panel ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }

  @keyframes cat-drop {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition), background var(--transition);
  }
  .cat-item:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .cat-item.all {
    color: var(--accent);
    margin-bottom: 4px;
  }
  .cat-item .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c, var(--accent));
    flex-shrink: 0;
  }

  /* ── Mobile drawer ── */
  .mobile-menu {
    position: fixed;
    top: var(--header-height);
    left: 0; right: 0;
    z-index: 99;
    background: var(--bg-brand);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 12%, transparent);
    display: flex;
    flex-direction: column;
    padding: 8px 16px 16px;
    gap: 2px;
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
    transition: transform 250ms ease, opacity 250ms ease;
  }
  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu a {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 600;
    padding: 12px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .mobile-menu a:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .mobile-divider {
    height: 1px;
    background: color-mix(in srgb, var(--text) 10%, transparent);
    margin: 6px 8px;
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .main-bar-inner {
      grid-template-columns: auto auto;
    }
    .search-wrap { display: none; }
    .mobile-search-toggle { display: flex; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const header      = document.getElementById('navbar') as HTMLElement;
  const hamburger   = document.getElementById('hamburger') as HTMLButtonElement;
  const mobileMenu  = document.getElementById('mobile-menu') as HTMLElement;
  const mobileSearchBtn = document.getElementById('mobile-search-btn') as HTMLButtonElement;
  const mobileSearchBar = document.getElementById('mobile-search-bar') as HTMLElement;

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.classList.toggle('open');
    mobileMenu?.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  mobileSearchBtn?.addEventListener('click', () => {
    mobileSearchBar?.classList.toggle('open');
    if (mobileSearchBar?.classList.contains('open')) {
      mobileSearchBar.querySelector('input')?.focus();
    }
  });

  // Panel desplegable de categorías
  const catToggle = document.getElementById('cat-toggle') as HTMLButtonElement;
  const catPanel  = document.getElementById('cat-panel') as HTMLElement;

  const isCatOpen = () => catToggle?.getAttribute('aria-expanded') === 'true';

  function setCatPanel(open: boolean) {
    if (!catPanel || !catToggle) return;
    catPanel.hidden = !open;
    catToggle.setAttribute('aria-expanded', String(open));
  }

  catToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setCatPanel(!isCatOpen());
  });

  document.addEventListener('click', (e) => {
    if (isCatOpen() && !catPanel.contains(e.target as Node)) {
      setCatPanel(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setCatPanel(false);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('open');
      mobileMenu?.classList.remove('open');
    });
  });

  import { cartStore, initCart } from '../../stores/cart';
  import { initAuth, userStore } from '../../stores/auth';

  initAuth();
  initCart();

  const userBtn = document.getElementById('user-btn');
  userStore.subscribe((user) => {
    userBtn?.classList.toggle('user-logged', user !== null);
  });

  const countEl = document.getElementById('cart-count');
  cartStore.subscribe((items) => {
    const total = items.reduce((acc, i) => acc + i.cantidad, 0);
    if (countEl) {
      countEl.textContent = String(total);
      countEl.classList.toggle('hidden', total === 0);
    }
  });
</script>
