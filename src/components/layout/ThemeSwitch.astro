<label class="switch" aria-label="Cambiar tema" title="Cambiar tema">
  <input type="checkbox" id="theme-input" />

  <!-- Moon: active in dark mode (left side) -->
  <svg class="sw-icon sw-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>

  <span class="track">
    <span class="thumb"></span>
  </span>

  <!-- Sun: active in light mode (right side) -->
  <svg class="sw-icon sw-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
</label>

<style>
  .switch {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    user-select: none;
  }

  input { display: none; }

  .sw-icon {
    flex-shrink: 0;
    transition: color var(--transition);
  }

  .sw-moon { color: var(--accent); }
  .sw-sun  { color: var(--text-muted); }

  input:checked ~ .sw-moon { color: var(--text-muted); }
  input:checked ~ .sw-sun  { color: var(--accent); }

  .track {
    position: relative;
    width: 44px;
    height: 24px;
    background: var(--bg-elevated);
    border: 1.5px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    flex-shrink: 0;
    transition: border-color var(--transition);
  }

  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent);
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  input:checked ~ .track .thumb {
    transform: translateX(20px);
  }
</style>

<script>
  import { toggleTheme, initTheme, themeStore } from '../../stores/theme';

  initTheme();

  const input = document.getElementById('theme-input') as HTMLInputElement;

  themeStore.subscribe((theme) => {
    if (input) input.checked = theme === 'light';
  });

  input?.addEventListener('change', toggleTheme);
</script>
