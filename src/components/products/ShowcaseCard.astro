---
import type { Product } from '../../lib/api';
import { minPrice } from '../../lib/api';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const images = product.variants[0]?.images?.length
  ? product.variants[0].images
  : product.images;

const visibleDots = images.slice(0, 5);
const firstVariant = product.variants[0];
const price = minPrice(product.variants);
const imagen = images[0] ?? '';
---

<div class="sc-card" data-sc-carousel>
  <div class="sc-img-area">
    {images.map((src, i) => (
      <img
        class={`sc-img${i === 0 ? ' sc-active' : ''}`}
        src={src}
        alt={product.title}
        loading="lazy"
      />
    ))}
    {product.featured && (
      <span class="sc-badge-featured">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        DESTACADO
      </span>
    )}
  </div>

  <div class="sc-footer">
    <div class="sc-meta">
      <span class="sc-brand">{product.brand ?? 'Producto'}</span>
      {visibleDots.length > 1 && (
        <div class="sc-dots">
          {visibleDots.map((_, i) => (
            <span class={`sc-dot${i === 0 ? ' sc-dot-active' : ''}`}></span>
          ))}
        </div>
      )}
    </div>

    <div class="sc-info">
      <div class="sc-text">
        <p class="sc-name">{product.title}</p>
        <p class="sc-price">$ {price.toLocaleString('es-CL')}</p>
      </div>
      <button
        class="sc-arrow"
        aria-label="Agregar al carrito"
        data-cart-variant={firstVariant?.id}
        data-cart-product={product.id}
        data-cart-nombre={product.title}
        data-cart-precio={firstVariant?.price ?? price}
        data-cart-imagen={imagen}
        data-cart-slug={product.slug}
        data-cart-sku={firstVariant?.sku ?? ''}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .sc-card {
    width: 210px;
    flex-shrink: 0;
    background: #1e2229;
    border-radius: 20px;
    overflow: hidden;
  }

  /* ── Imagen ── */
  .sc-img-area {
    position: relative;
    height: 170px;
    background: #272b34;
  }

  .sc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    opacity: 0;
    transition: opacity 0.55s ease;
  }
  .sc-img.sc-active { opacity: 1; }

  .sc-badge-featured {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--on-accent);
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--accent);
    box-shadow: var(--neon-border);
    text-shadow: var(--neon-text);
  }

  /* ── Footer ── */
  .sc-footer {
    padding: 12px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sc-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sc-brand {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Dots */
  .sc-dots {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sc-dot {
    height: 6px;
    width: 6px;
    border-radius: 999px;
    background: rgba(255,255,255,0.22);
    transition: width 0.3s ease, background 0.3s ease;
  }
  .sc-dot.sc-dot-active {
    width: 18px;
    background: #fff;
  }

  /* Nombre + precio + flecha */
  .sc-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .sc-text { flex: 1; min-width: 0; }

  .sc-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sc-price {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 3px 0 0;
  }

  .sc-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #2e333d;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #fff;
    transition: background 0.2s, color 0.2s;
  }
  .sc-arrow:hover  { background: var(--accent); color: #000; }
  .sc-arrow.added  { background: #4ade80; color: #000; }
</style>

<script>
  import { initCart, addToCart } from '../../stores/cart';

  initCart();

  // Carrusel + dots
  document.querySelectorAll<HTMLElement>('[data-sc-carousel]').forEach(card => {
    const imgs = card.querySelectorAll<HTMLElement>('.sc-img');
    const dots = card.querySelectorAll<HTMLElement>('.sc-dot');
    if (imgs.length > 1) {
      let i = 0;
      setInterval(() => {
        imgs[i].classList.remove('sc-active');
        dots[i]?.classList.remove('sc-dot-active');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('sc-active');
        dots[i]?.classList.add('sc-dot-active');
      }, 4000);
    }

    // Botón agregar al carrito
    const btn = card.querySelector<HTMLButtonElement>('.sc-arrow');
    btn?.addEventListener('click', () => {
      const d = btn.dataset;
      if (!d.cartVariant) return;
      addToCart({
        variantId: d.cartVariant,
        productId: d.cartProduct!,
        nombre:    d.cartNombre!,
        precio:    Number(d.cartPrecio),
        cantidad:  1,
        imagen:    d.cartImagen!,
        slug:      d.cartSlug ?? null,
        sku:       d.cartSku!,
      });
      btn.classList.add('added');
      setTimeout(() => btn.classList.remove('added'), 1200);
    });
  });
</script>
