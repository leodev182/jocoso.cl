---
import type { Product } from '../../lib/api';
import { minPrice, totalStock, isMainTag } from '../../lib/api';
import Badge from '../ui/Badge.astro';

interface Props {
  product: Product;
  // minimal = solo imagen, nombre, precio y botones (sin marca/tags/hashtags)
  minimal?: boolean;
}

const { product, minimal = false } = Astro.props;
const price    = minPrice(product.variants);
const stock    = totalStock(product.variants);
const href     = product.slug ? `/productos/${product.slug}` : `/productos/${product.id}`;
const image    = product.images?.[0] ?? null;
const mainTags = product.tags.filter(isMainTag).slice(0, 3);
const hashTags = product.tags.filter((t) => !isMainTag(t)).slice(0, 4);
const multiVariant = product.variants.length > 1;
const firstVariant = product.variants[0];
---

<div
  class:list={["product-card", { "product-card--no-stock": stock === 0 }]}
  data-product-id={product.id}
  data-variant-id={firstVariant?.id ?? ''}
  data-nombre={product.title}
  data-precio={price}
  data-sku={firstVariant?.sku ?? ''}
  data-slug={product.slug ?? ''}
  data-imagen={image ?? ''}
>
  <!-- Imagen -->
  <a href={href} class="card-image-link">
    <div class="card-image">
      {image
        ? <img src={image} alt={product.title} loading="lazy" />
        : <div class="card-no-image">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
      }

      {product.featured && (
        <span class="badge-featured" aria-label="Producto destacado">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          DESTACADO
        </span>
      )}

      <!-- Wishlist -->
      <button class="btn-wishlist" aria-label="Agregar a wishlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
      </button>

      <!-- Add to cart (slide-up) -->
      <button class="btn-add-cart" data-multi={multiVariant} aria-label="Agregar al carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
        <span class="add-label" data-default={multiVariant ? 'Ver opciones' : 'Agregar'}>{multiVariant ? 'Ver opciones' : 'Agregar'}</span>
      </button>
    </div>
  </a>

  <!-- Info -->
  <a href={href} class="card-body">
    {!minimal && product.brand && <p class="card-brand">{product.brand}</p>}
    <p class="card-title">{product.title}</p>
    {!minimal && mainTags.length > 0 && (
      <div class="card-tags">
        {mainTags.map((tag) => <Badge color={tag.color}>{tag.name}</Badge>)}
      </div>
    )}
    {!minimal && hashTags.length > 0 && (
      <div class="card-hashtags">
        {hashTags.map((tag) => (
          <span class="hashtag" style={`--c: ${tag.color}`}>{tag.name}</span>
        ))}
      </div>
    )}
    <div class="card-bottom">
      <span class="card-price">
        {multiVariant && <small>desde </small>}
        $ {price.toLocaleString('es-CL')}
      </span>
      {stock === 0 && <Badge variant="danger">Sin stock</Badge>}
    </div>
  </a>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: #1a1d24;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
    transition: transform 220ms ease, border-color 220ms, box-shadow 220ms;
  }
  .product-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 12px 40px rgba(0,0,0,0.25), var(--neon-subtle);
  }

  /* ── Image ── */
  .card-image-link { display: block; }

  .card-image {
    position: relative;
    aspect-ratio: 1;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
    transition: transform 300ms ease, filter 300ms ease, opacity 300ms ease;
  }
  .product-card:hover .card-image img { transform: scale(1.06); }

  /* Sin stock */
  .product-card--no-stock .card-image img {
    filter: blur(3px) grayscale(0.4);
    opacity: 0.55;
  }
  .product-card--no-stock:hover .card-image img {
    filter: blur(3px) grayscale(0.4);
    opacity: 0.55;
    transform: none;
  }
  .product-card--no-stock .btn-add-cart { display: none; }

  .card-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    opacity: 0.4;
  }

  /* Featured badge */
  .badge-featured {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--on-accent);
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--accent);
    box-shadow: var(--neon-border);
    text-shadow: var(--neon-text);
  }

  /* Wishlist button */
  .btn-wishlist {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 200ms, transform 200ms, color 200ms, background 200ms;
  }
  .product-card:hover .btn-wishlist {
    opacity: 1;
    transform: scale(1);
  }
  .btn-wishlist:hover {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 15%, var(--bg));
  }
  .btn-wishlist.active {
    color: var(--danger);
    fill: var(--danger);
  }

  /* Add to cart slide-up */
  .btn-add-cart {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 10px;
    cursor: pointer;
    transform: translateY(100%);
    transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1), background var(--transition);
  }
  .product-card:hover .btn-add-cart { transform: translateY(0); }
  .btn-add-cart:hover { filter: brightness(1.1); }
  .btn-add-cart.added { background: var(--success); }

  /* ── Body ── */
  .card-body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 2px;
  }

  .card-hashtags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .hashtag {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--c, var(--text-muted));
    opacity: 0.85;
  }

  .card-brand {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .card-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
  }

  .card-price {
    font-size: 1rem;
    font-weight: 800;
    color: var(--accent);
  }
  .card-price small {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.8;
  }
</style>

<script>
  import { initCart, addToCart } from '../../stores/cart';
  import { initAuth, tokenStore } from '../../stores/auth';
  import { wishlistStore, initWishlist, toggleWishlist } from '../../stores/wishlist';

  initAuth();
  initCart();
  initWishlist();

  wishlistStore.subscribe((ids) => {
    document.querySelectorAll<HTMLElement>('.product-card').forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('.btn-wishlist');
      const svg = btn?.querySelector('svg');
      if (ids.has(card.dataset.productId ?? '')) {
        btn?.classList.add('active');
        svg?.setAttribute('fill', 'currentColor');
      } else {
        btn?.classList.remove('active');
        svg?.setAttribute('fill', 'none');
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.product-card').forEach((card) => {
    const cartBtn = card.querySelector<HTMLButtonElement>('.btn-add-cart');
    const wishBtn = card.querySelector<HTMLButtonElement>('.btn-wishlist');
    const linkEl  = card.querySelector<HTMLAnchorElement>('.card-image-link');
    const label   = cartBtn?.querySelector<HTMLElement>('.add-label');

    cartBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (cartBtn.dataset.multi === 'true') {
        window.location.href = linkEl?.href ?? '#';
        return;
      }
      if (!tokenStore.get()) {
        location.href = `/login?redirect=${encodeURIComponent(location.pathname)}`;
        return;
      }
      const d = card.dataset;
      addToCart({
        variantId: d.variantId ?? '',
        productId: d.productId ?? '',
        nombre:    d.nombre ?? '',
        precio:    Number(d.precio ?? 0),
        cantidad:  1,
        imagen:    d.imagen ?? '',
        slug:      d.slug || null,
        sku:       d.sku ?? '',
      });
      if (label) label.textContent = '✓ Agregado';
      cartBtn.classList.add('added');
      setTimeout(() => {
        if (label) label.textContent = label.dataset.default ?? 'Agregar';
        cartBtn.classList.remove('added');
      }, 1500);
    });

    wishBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (!tokenStore.get()) {
        location.href = `/login?redirect=${encodeURIComponent(location.pathname)}`;
        return;
      }
      await toggleWishlist(card.dataset.productId ?? '');
    });
  });
</script>
