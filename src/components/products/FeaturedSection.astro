---
import type { Product } from '../../lib/api';
import ProductGrid from './ProductGrid.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

{products.length > 0 && (
  <section class="featured-section">
    <div class="featured-inner">

      <!-- Izquierda: grid de productos destacados -->
      <div class="featured-left">
        <h2 class="featured-title">Destacados</h2>
        <ProductGrid products={products} minimal={true} />
      </div>

      <!-- Derecha: tarjeta de producto (bajada del hero) -->
      <div class="featured-right">
        <div class="card-wrapper">
          <div id="featured-card" class="card-scene">
            <div class="card-stack">
              <div class="card card-back-2"></div>
              <div class="card card-back-1"></div>
              <div class="card card-front">
                <div class="card-img-area">
                  <div class="card-img-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.35">
                      <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
                    </svg>
                    <span>Foto producto</span>
                  </div>
                </div>
                <div class="card-body">
                  <div class="card-tags">
                    <span class="tag">Gaming</span>
                    <span class="tag tag-new">Nuevo</span>
                  </div>
                  <p class="card-name">Monitor Gaming 24" 165Hz IPS</p>
                  <div class="card-footer">
                    <span class="card-price">$ 189.990</span>
                    <span class="card-stock">En stock</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
)}

<style>
  .featured-section {
    background: var(--bg);
    padding: 48px 0;
  }

  .featured-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 30%;
    gap: 40px;
    align-items: center;
  }

  .featured-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.5px;
    margin: 0 0 24px;
  }

  /* ── Tarjeta derecha ── */
  .featured-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-wrapper { animation: float 5s ease-in-out infinite; }
  .card-scene   { perspective: 1200px; }

  .card-stack {
    position: relative;
    width: 240px;
    height: 320px;
    transform-style: preserve-3d;
    transition: transform 0.08s ease-out;
  }

  .card {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card-front {
    background: #1a1d24;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: var(--neon-border), 0 24px 48px rgba(0,0,0,0.25);
    transform: translateZ(0px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card-back-1 {
    background: #22262f;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    transform: translateZ(-20px) scale(0.96);
    opacity: 0.7;
  }
  .card-back-2 {
    background: #111318;
    border: 1px solid color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateZ(-40px) scale(0.92);
    opacity: 0.4;
  }

  :global([data-theme="light"]) .card-front {
    background: rgba(5, 32, 74, 0.85);
    border-color: rgba(46,230,255,0.45);
    box-shadow: 0 0 0 1px rgba(46,230,255,0.2), 0 24px 48px rgba(0,0,0,0.25);
    backdrop-filter: blur(12px);
  }
  :global([data-theme="light"]) .card-back-1 {
    background: rgba(5,32,74,0.6);
    border-color: rgba(46,230,255,0.15);
  }
  :global([data-theme="light"]) .card-back-2 {
    background: rgba(5,32,74,0.35);
    border-color: rgba(46,230,255,0.08);
  }

  .card-img-area {
    flex: 1;
    background: linear-gradient(135deg, #22262f 0%, #111318 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .card-img-area::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--accent) 10%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .card-img-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.35);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    z-index: 1;
  }

  .card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #1a1d24;
  }
  :global([data-theme="light"]) .card-body { background: rgba(5,32,74,0.9); }

  .card-tags { display: flex; gap: 6px; }
  .tag {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }
  .tag-new {
    background: rgba(74,222,128,0.12);
    color: #4ade80;
  }

  .card-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.3;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card-price {
    font-size: 1rem;
    font-weight: 800;
    color: var(--accent);
  }
  .card-stock {
    font-size: 0.68rem;
    font-weight: 700;
    color: #4ade80;
    background: rgba(74,222,128,0.1);
    padding: 2px 8px;
    border-radius: 4px;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-14px); }
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .featured-inner {
      grid-template-columns: 1fr;
    }
    .featured-right { display: none; }
  }

  @media (max-width: 480px) {
    .featured-section { padding: 32px 0; }
    .featured-inner { padding: 0 16px; gap: 0; }
  }
</style>

<script>
  const scene = document.getElementById('featured-card') as HTMLElement;
  const stack = scene?.querySelector('.card-stack') as HTMLElement;

  if (scene && stack) {
    scene.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = scene.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width - 0.5) * 24;
      const y = ((e.clientY - rect.top) / rect.height - 0.5) * -24;
      stack.style.transform = `rotateX(${y}deg) rotateY(${x}deg)`;
    }, { passive: true });
    scene.addEventListener('mouseleave', () => {
      stack.style.transform = '';
    });
  }
</script>
