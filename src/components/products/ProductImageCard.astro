---
import type { Product } from '../../lib/api';
import { minPrice } from '../../lib/api';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const images = product.variants[0]?.images?.length
  ? product.variants[0].images
  : product.images;

const price = minPrice(product.variants);
const href = `/productos/${product.slug ?? product.id}`;
---

<a href={href} class="pic-card" data-carousel>
  <div class="cs-track">
    {images.map((src, i) => (
      <img
        class={`cs-img${i === 0 ? ' cs-active' : ''}`}
        src={src}
        alt={product.title}
        loading="lazy"
      />
    ))}
  </div>

  <div class="pic-overlay">
    <span class="pic-price">$ {price.toLocaleString('es-CL')}</span>
    <span class="pic-btn">Comprar</span>
  </div>
</a>

<style>
  .pic-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    /* altura viene del grid padre */
  }

  .cs-track {
    position: absolute;
    inset: 0;
  }

  .cs-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .cs-img.cs-active { opacity: 1; }

  /* Overlay visible solo en hover */
  .pic-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, transparent 55%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .pic-card:hover .pic-overlay { opacity: 1; }

  .pic-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
  }

  .pic-btn {
    background: var(--accent);
    color: #000;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>

<script>
  // Inicializa todos los carruseles de la página — Astro deduplica este script
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(el => {
    const imgs = el.querySelectorAll<HTMLElement>('.cs-img');
    if (imgs.length <= 1) return;
    let i = 0;
    setInterval(() => {
      imgs[i].classList.remove('cs-active');
      i = (i + 1) % imgs.length;
      imgs[i].classList.add('cs-active');
    }, 4000);
  });
</script>
