<style>
  .hc-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .hc-obj {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%; height: 100%;
    opacity: 0;
    overflow: visible;
  }

  .hc-obj.hc-active { opacity: 1; }

  /* ── Steam in / out ── */
  .hc-obj.hc-leaving {
    animation: steam-out 1.2s cubic-bezier(.22,.61,.36,1) forwards;
  }
  .hc-obj.hc-entering {
    animation: steam-in 1.2s cubic-bezier(.22,.61,.36,1) forwards;
  }

  @keyframes steam-out {
    0%   { opacity: 1; transform: translate(-50%,-50%) rotate(0deg)   scale(1);    filter: blur(0); }
    40%  { opacity: 1; transform: translate(-50%,-50%) rotate(60deg)  scale(1.1);  }
    100% { opacity: 0; transform: translate(-50%,-50%) rotate(180deg) scale(0.25); filter: blur(20px); }
  }
  @keyframes steam-in {
    0%   { opacity: 0; transform: translate(-50%,-50%) rotate(-180deg) scale(0.25); filter: blur(20px); }
    60%  { opacity: 1; transform: translate(-50%,-50%) rotate(20deg)   scale(1.08); filter: blur(4px); }
    100% { opacity: 1; transform: translate(-50%,-50%) rotate(0deg)    scale(1);    filter: blur(0); }
  }

  /* ── Luz neon — traza continua en idle, draw/erase en transición ── */
  .hc-body {
    stroke-dasharray: 45 955;
    stroke-dashoffset: 1000;
    animation: hc-trace 2s linear infinite;
    filter:
      drop-shadow(0 0 5px var(--accent))
      drop-shadow(0 0 14px var(--accent-mid))
      drop-shadow(0 0 30px var(--accent-glow));
  }
  @keyframes hc-trace {
    from { stroke-dashoffset: 1000; }
    to   { stroke-dashoffset: 0; }
  }

  .hc-leaving .hc-body {
    animation: erase 1.2s linear forwards;
  }
  .hc-entering .hc-body {
    animation: draw 1.2s linear forwards;
  }

  @keyframes erase {
    from { stroke-dashoffset: 0;    opacity: 1; }
    to   { stroke-dashoffset: 1000; opacity: 0; }
  }
  @keyframes draw {
    from { stroke-dashoffset: 1000; opacity: 0; }
    to   { stroke-dashoffset: 0;    opacity: 1; }
  }

  /* Detalles interiores: pulso suave */
  .hc-detail {
    fill: none;
    opacity: 0;
    animation: hc-pulse 2.8s ease-in-out infinite;
    filter: drop-shadow(0 0 3px var(--accent));
  }
  @keyframes hc-pulse {
    0%, 100% { opacity: 0.2; }
    50%       { opacity: 0.7; }
  }

  @media (max-width: 900px) {
    .hc-wrap { width: 240px !important; height: 240px !important; }
  }
</style>

<script>
  const DISPLAY   = 4000;
  const OUT_TIME  = 1300;
  const IN_OFFSET = 400;

  const objs = Array.from(document.querySelectorAll<HTMLElement>('.hc-obj'));

  if (objs.length > 1) {
    let cur = 0;

    function cycle() {
      const leaving  = objs[cur];
      const nextIdx  = (cur + 1) % objs.length;
      const entering = objs[nextIdx];

      leaving.classList.remove('hc-active');
      leaving.classList.add('hc-leaving');

      setTimeout(() => { entering.classList.add('hc-entering'); }, IN_OFFSET);

      setTimeout(() => {
        leaving.classList.remove('hc-leaving');
        entering.classList.remove('hc-entering');
        entering.classList.add('hc-active');
        cur = nextIdx;
        setTimeout(cycle, DISPLAY);
      }, OUT_TIME + 200);
    }

    setTimeout(cycle, DISPLAY);
  }
</script>
