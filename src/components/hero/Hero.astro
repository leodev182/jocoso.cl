---
import Button from '../ui/Button.astro';
---

<!-- hero-section da el fondo full-width; hero limita el ancho del contenido -->
<section class="hero-section">
  <div class="hero">
    <div class="hero-content">
      <div class="hero-badge">Gaming · Periféricos · Tecnología</div>

      <h1 class="hero-headline">
        Tu setup al<br />
        <span class="headline-accent">siguiente nivel</span>
      </h1>

      <p class="hero-sub">
        Los mejores productos gaming con envío rápido a todo Chile.<br />
        Stock real, precios reales.
      </p>

      <div class="hero-ctas">
        <Button href="/productos" variant="primary">Ver productos</Button>
        <Button href="/ofertas" variant="ghost">Ver ofertas</Button>
      </div>
    </div>

    <div class="hero-visual">
      <div class="card-wrapper">
        <div id="hero-card" class="card-scene">
          <div class="card-stack">
            <div class="card card-back-2"></div>
            <div class="card card-back-1"></div>
            <div class="card card-front">
              <div class="card-img-area">
                <div class="card-img-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.35">
                    <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
                  </svg>
                  <span>Foto producto</span>
                </div>
              </div>
              <div class="card-body">
                <div class="card-tags">
                  <span class="tag">Gaming</span>
                  <span class="tag tag-ml">ML</span>
                </div>
                <p class="card-name">Monitor Gaming 27" 165Hz</p>
                <div class="card-footer">
                  <span class="card-price">$ 299.990</span>
                  <span class="card-stock">En stock</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Fondo full-width ── */
  /* Mobile first */
  .hero-section {
    background: #FFFFFF;
    display: flex;
    align-items: center;
    padding: 48px 0;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 0 20px;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-visual { display: none; }

  /* Desktop */
  @media (min-width: 769px) {
    .hero-section {
      height: 67svh;
      padding: 0;
    }
    .hero {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 64px;
      padding: 0 24px;
    }
    .hero-visual { display: flex; }
    .hero-badge  { align-self: auto; }
    .hero-sub    { max-width: 420px; }
    .hero-ctas   { justify-content: flex-start; }
  }

  /* ── Texto dark mode (sobre fondo blanco) ── */
  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent-glow);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
  }

  .hero-headline {
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    color: #111318;
    margin: 0;
  }

  .headline-accent {
    display: block;
    color: var(--accent);
  }

  .hero-sub {
    font-size: 1rem;
    color: #555e6e;
    line-height: 1.65;
    margin: 0;
    max-width: 420px;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* El layout del botón vive en ui/Button; aquí solo el color de la sección
     invertida (fondo claro), donde el ghost necesita texto/borde oscuro */
  .hero-ctas :global(.btn.ghost) {
    border-color: color-mix(in srgb, #111318 25%, transparent);
    color: #111318;
  }
  .hero-ctas :global(.btn.ghost):hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Light mode: gradiente azul ── */
  :global([data-theme="light"]) .hero-section {
    background: linear-gradient(135deg, #05204A 0%, #0d4a8a 50%, #1CC8E5 100%);
  }
  :global([data-theme="light"]) .hero-headline { color: #FFFFFF; }
  :global([data-theme="light"]) .hero-sub      { color: rgba(255,255,255,0.8); }
  :global([data-theme="light"]) .hero-badge {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.3);
    color: #FFFFFF;
  }
  :global([data-theme="light"]) .hero-ctas :global(.btn.primary) {
    background: #FFFFFF;
    color: #05204A;
  }
  :global([data-theme="light"]) .hero-ctas :global(.btn.ghost) {
    border-color: rgba(255,255,255,0.4);
    color: #FFFFFF;
  }
  :global([data-theme="light"]) .hero-ctas :global(.btn.ghost):hover {
    border-color: #FFFFFF;
    color: #FFFFFF;
  }

  /* ── 3D card ── */
  .hero-visual {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-wrapper { animation: float 5s ease-in-out infinite; }
  .card-scene   { perspective: 1200px; }

  .card-stack {
    position: relative;
    width: 300px;
    height: 400px;
    transform-style: preserve-3d;
    transition: transform 0.08s ease-out;
  }

  .card {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card-front {
    background: #1a1d24;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: var(--neon-border), 0 24px 48px rgba(0,0,0,0.25);
    transform: translateZ(0px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card-back-1 {
    background: #22262f;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    transform: translateZ(-20px) scale(0.96);
    opacity: 0.7;
  }
  .card-back-2 {
    background: #111318;
    border: 1px solid color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateZ(-40px) scale(0.92);
    opacity: 0.4;
  }

  :global([data-theme="light"]) .card-front {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.45);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.2), 0 24px 48px rgba(0,0,0,0.25);
    backdrop-filter: blur(12px);
  }
  :global([data-theme="light"]) .card-back-1 {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.15);
  }
  :global([data-theme="light"]) .card-back-2 {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.08);
  }

  .card-img-area {
    flex: 1;
    background: linear-gradient(135deg, #22262f 0%, #111318 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .card-img-area::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--accent) 10%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global([data-theme="light"]) .card-img-area {
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.03) 100%);
  }
  :global([data-theme="light"]) .card-img-area::before {
    background-image: radial-gradient(circle, rgba(255,255,255,0.18) 1px, transparent 1px);
  }

  .card-img-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.35);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    z-index: 1;
  }

  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #1a1d24;
  }
  :global([data-theme="light"]) .card-body {
    background: rgba(255,255,255,0.08);
  }

  .card-tags { display: flex; gap: 6px; }
  .tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }
  .tag-ml {
    background: rgba(255,224,0,0.12);
    color: #FFE000;
  }

  .card-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent);
  }
  .card-stock {
    font-size: 0.7rem;
    font-weight: 700;
    color: #4ade80;
    background: rgba(74,222,128,0.1);
    padding: 2px 8px;
    border-radius: 4px;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-16px); }
  }

  /* ── Responsive ── */
</style>

<script>
  const scene = document.getElementById('hero-card') as HTMLElement;
  const stack = scene?.querySelector('.card-stack') as HTMLElement;

  if (scene && stack) {
    scene.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = scene.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width - 0.5) * 28;
      const y = ((e.clientY - rect.top) / rect.height - 0.5) * -28;
      stack.style.transform = `rotateX(${y}deg) rotateY(${x}deg)`;
    }, { passive: true });

    scene.addEventListener('mouseleave', () => {
      stack.style.transform = '';
    });
  }
</script>
