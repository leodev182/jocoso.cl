---
import Button from '../ui/Button.astro';
import HeroCarousel from './HeroCarousel.astro';
---

<!-- hero-section da el fondo full-width; hero limita el ancho del contenido -->
<section class="hero-section">
  <div class="hero">
    <div class="hero-content">
      <div class="hero-badge">Gaming · Periféricos · Tecnología</div>

      <h1 class="hero-headline">
        Tu setup al<br />
        <span class="headline-accent">siguiente nivel</span>
      </h1>

      <p class="hero-sub">
        Los mejores productos gaming con envío rápido a todo Chile.<br />
        Stock real, precios reales.
      </p>

      <div class="hero-ctas">
        <Button href="/productos" variant="primary">Ver productos</Button>
        <Button href="/ofertas" variant="ghost">Ver ofertas</Button>
      </div>
    </div>

    <div class="hero-visual">
      <HeroCarousel size={300} />
    </div>
  </div>
</section>

<style>
  /* ── Fondo full-width ── */
  /* Mobile first */
  .hero-section {
    background: rgba(255, 255, 255, 0.13);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    padding: 48px 0;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 0 20px;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* oculto en mobile, se muestra en desktop */
  .hero-visual { display: none; }

  /* Desktop */
  @media (min-width: 769px) {
    .hero-section {
      min-height: 55svh;
      padding: 48px 0;
    }
    .hero {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 64px;
      padding: 0 24px;
    }
    .hero-badge  { align-self: auto; }
    .hero-sub    { max-width: 520px; }
    .hero-ctas   { justify-content: flex-start; }
    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    background: var(--glass-bg-alt);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
  }

  .hero-headline {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0;
  }

  .headline-accent {
    display: block;
    background: linear-gradient(135deg, #ffffff 0%, #2EE6FF 55%, #1CC8E5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding-bottom: 0.15em;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 420px;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* El layout del botón vive en ui/Button; aquí solo el color de la sección
     invertida (fondo claro), donde el ghost necesita texto/borde oscuro */
  /* Ambos botones del hero — pill shape + glass */
  .hero-ctas :global(.btn) {
    border-radius: 999px;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    font-weight: 500;
    padding: 9px 24px;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  /* Primary — tinte cyan glass */
  .hero-ctas :global(.btn.primary) {
    background: linear-gradient(135deg, rgba(46,230,255,0.45) 0%, rgba(28,200,229,0.40) 100%);
    border: 1px solid rgba(46,230,255,0.5);
    box-shadow: 0 4px 24px rgba(46,230,255,0.25), inset 0 1px 0 rgba(255,255,255,0.2);
    color: #fff;
  }
  .hero-ctas :global(.btn.primary):hover {
    background: linear-gradient(135deg, rgba(46,230,255,0.65) 0%, rgba(28,200,229,0.60) 100%);
    box-shadow: 0 8px 36px rgba(46,230,255,0.4), inset 0 1px 0 rgba(255,255,255,0.25);
    transform: translateY(-2px);
    filter: none;
  }

  /* Ghost — neutral glass */
  .hero-ctas :global(.btn.ghost) {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.22);
    box-shadow: 0 8px 32px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.3);
    color: var(--text);
  }
  .hero-ctas :global(.btn.ghost):hover {
    background: rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.35);
    transform: translateY(-2px);
    color: var(--text);
  }

  /* ── Light mode ── */
  :global([data-theme="light"]) .hero-section {
    background: rgba(255, 255, 255, 0.55);
  }

  /* Gradiente oscuro navy → teal para el headline en light */
  :global([data-theme="light"]) .hero-headline {
    background: linear-gradient(135deg, #05204A 0%, #0d4a8a 50%, #1CC8E5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  :global([data-theme="light"]) .headline-accent {
    background: linear-gradient(135deg, #05204A 0%, #0A7FA0 50%, #1CC8E5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global([data-theme="light"]) .hero-sub { color: #444e5e; }

  :global([data-theme="light"]) .hero-badge {
    background: rgba(255,255,255,0.6);
    border-color: rgba(15,23,42,0.12);
    color: #05204A;
  }

  :global([data-theme="light"]) .hero-ctas :global(.btn.primary) {
    background: linear-gradient(135deg, rgba(28,200,229,0.5) 0%, rgba(10,127,160,0.5) 100%);
    border-color: rgba(28,200,229,0.55);
    color: #05204A;
  }
  :global([data-theme="light"]) .hero-ctas :global(.btn.ghost) {
    background: rgba(255,255,255,0.65);
    border-color: rgba(15,23,42,0.18);
    color: #05204A;
  }
  :global([data-theme="light"]) .hero-ctas :global(.btn.ghost):hover {
    border-color: #1CC8E5;
    color: #05204A;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-16px); }
  }

  /* ── Responsive ── */
</style>

