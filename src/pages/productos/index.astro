---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getAllStorefrontProducts, getStorefrontTags, isMainTag } from '../../lib/api';

const [products, tags] = await Promise.all([
  getAllStorefrontProducts(),
  getStorefrontTags(),
]);

const mainTags = tags.filter(isMainTag);
---

<Base title="Catálogo">
  <section class="catalog">
    <header class="catalog-head">
      <h1 id="catalog-title">Catálogo</h1>
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="search" id="catalog-search" placeholder="Buscar productos..." autocomplete="off" />
      </div>
    </header>

    <div class="filters">
      <button class="chip active" data-tag="">Todos</button>
      {mainTags.map((t) => (
        <button class="chip" data-tag={t.slug}>
          <span class="dot" style={`--c: ${t.color}`}></span>
          {t.name}
        </button>
      ))}
    </div>

    <p class="count" id="catalog-count"></p>

    <div class="catalog-grid" id="catalog-grid">
      {products.map((p) => (
        <div
          class="catalog-item"
          data-tags={p.tags.map((t) => t.slug).join(',')}
          data-title={p.title.toLowerCase()}
          data-featured={String(p.featured)}
        >
          <ProductCard product={p} />
        </div>
      ))}
    </div>

    <p class="empty" id="catalog-empty" hidden>No se encontraron productos con esos filtros.</p>

    <div class="more-wrap">
      <button class="btn-more" id="load-more" hidden>Cargar más</button>
    </div>
  </section>
</Base>

<style>
  .catalog {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .catalog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .catalog-head h1 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1.5px solid color-mix(in srgb, var(--text) 12%, transparent);
    border-radius: var(--radius-md);
    padding: 0 14px;
    height: 42px;
    min-width: 280px;
    color: var(--text-muted);
    transition: border-color var(--transition);
  }
  .search-box:focus-within { border-color: var(--accent); box-shadow: var(--neon-subtle); }
  .search-box input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background: #1a1d24;
    color: rgba(255, 255, 255, 0.55);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .chip:hover { color: #ffffff; }
  .chip.active {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, #1a1d24);
  }
  .chip .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--accent)); }

  .count { color: var(--text-muted); font-size: 0.82rem; margin-bottom: 16px; }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .catalog-item.hidden { display: none; }

  .empty { text-align: center; color: var(--text-muted); padding: 48px 0; }

  .more-wrap { display: flex; justify-content: center; margin-top: 28px; }
  .btn-more {
    padding: 11px 28px;
    border-radius: var(--radius-md);
    border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: none;
    color: var(--accent);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition);
  }
  .btn-more:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }

  @media (max-width: 600px) {
    .catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .search-box { min-width: 0; width: 100%; }
  }
</style>

<script>
  const PAGE_SIZE = 12;

  const items     = Array.from(document.querySelectorAll<HTMLElement>('.catalog-item'));
  const chips     = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const searchEl  = document.getElementById('catalog-search') as HTMLInputElement | null;
  const titleEl   = document.getElementById('catalog-title');
  const countEl   = document.getElementById('catalog-count');
  const emptyEl   = document.getElementById('catalog-empty');
  const moreBtn   = document.getElementById('load-more') as HTMLButtonElement | null;

  // slug → nombre de categoría (para el título)
  const tagNames = new Map<string, string>();
  chips.forEach((c) => { if (c.dataset.tag) tagNames.set(c.dataset.tag, c.textContent?.trim() ?? ''); });

  let activeTag = '';
  let search = '';
  let featuredOnly = false;
  let shown = PAGE_SIZE;

  function matches(item: HTMLElement): boolean {
    const tags = (item.dataset.tags ?? '').split(',');
    const title = item.dataset.title ?? '';
    if (activeTag && !tags.includes(activeTag)) return false;
    if (featuredOnly && item.dataset.featured !== 'true') return false;
    if (search && !title.includes(search)) return false;
    return true;
  }

  function render() {
    let matched = 0;
    items.forEach((item) => {
      if (matches(item)) {
        item.classList.toggle('hidden', matched >= shown);
        matched++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (emptyEl) emptyEl.hidden = matched > 0;
    if (moreBtn) moreBtn.hidden = matched <= shown;
    if (countEl) countEl.textContent = matched > 0 ? `${matched} producto${matched === 1 ? '' : 's'}` : '';
  }

  function updateTitle() {
    if (!titleEl) return;
    if (featuredOnly) titleEl.textContent = 'Destacados';
    else if (activeTag) titleEl.textContent = tagNames.get(activeTag) ?? 'Catálogo';
    else titleEl.textContent = 'Catálogo';
  }

  function setActiveChip() {
    chips.forEach((c) => c.classList.toggle('active', (c.dataset.tag ?? '') === activeTag));
  }

  // Estado inicial desde la URL
  const params = new URLSearchParams(location.search);
  activeTag = params.get('tag') ?? '';
  search = (params.get('search') ?? '').toLowerCase();
  featuredOnly = params.get('featured') === 'true';
  if (searchEl && search) searchEl.value = search;
  setActiveChip();
  updateTitle();
  render();

  // Interacción: chips de categoría
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeTag = chip.dataset.tag ?? '';
      featuredOnly = false;
      shown = PAGE_SIZE;
      setActiveChip();
      updateTitle();
      render();
      const url = new URL(location.href);
      activeTag ? url.searchParams.set('tag', activeTag) : url.searchParams.delete('tag');
      url.searchParams.delete('featured');
      history.replaceState({}, '', url);
    });
  });

  // Búsqueda
  searchEl?.addEventListener('input', () => {
    search = searchEl.value.trim().toLowerCase();
    shown = PAGE_SIZE;
    render();
  });

  // Cargar más
  moreBtn?.addEventListener('click', () => { shown += PAGE_SIZE; render(); });
</script>
