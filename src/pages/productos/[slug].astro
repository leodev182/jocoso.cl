---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/ui/Badge.astro';
import { getAllStorefrontProducts, minPrice, totalStock, isMainTag } from '../../lib/api';

export async function getStaticPaths() {
  const data = await getAllStorefrontProducts();
  return data.map((product) => ({
    params: { slug: product.slug ?? product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

const price        = minPrice(product.variants);
const stock        = totalStock(product.variants);
const mainTags     = product.tags.filter(isMainTag);
const hashTags     = product.tags.filter((t) => !isMainTag(t));
const images       = product.images?.length ? product.images : [];
const multiVariant = product.variants.length > 1;
const metaDesc     = product.description?.replace(/\s+/g, ' ').trim().slice(0, 155) ?? '';

// Atributos cuyo valor DIFIERE entre variantes = lo que realmente las distingue
// (ej. "Color"). Si en el futuro se cargan en ops, la etiqueta los usa automáticamente.
const diffAttrNames = new Set<string>();
{
  const byName = new Map<string, Set<string>>();
  for (const v of product.variants) {
    for (const a of v.attributes ?? []) {
      if (!byName.has(a.name)) byName.set(a.name, new Set());
      byName.get(a.name)!.add(a.value);
    }
  }
  for (const [name, values] of byName) if (values.size > 1) diffAttrNames.add(name);
}

// Detecta si "Color" es un atributo diferenciador → swatches en vez de texto
const isColorVariant = [...diffAttrNames].some(n => n.toLowerCase() === 'color');

// Mapa de nombres de color en español/inglés → hex
function toColorHex(val: string): string {
  const map: Record<string, string> = {
    blanco: '#f0f0f0', negro: '#1a1a1a', azul: '#2563eb', rojo: '#dc2626',
    verde: '#16a34a', amarillo: '#eab308', naranja: '#f97316', morado: '#7c3aed',
    rosado: '#ec4899', gris: '#6b7280', plateado: '#94a3b8', dorado: '#d97706',
    cyan: '#2EE6FF', celeste: '#38bdf8', cafe: '#92400e', beige: '#d4b483',
    white: '#f0f0f0', black: '#1a1a1a', blue: '#2563eb', red: '#dc2626',
    green: '#16a34a', gray: '#6b7280', silver: '#94a3b8', gold: '#d97706',
  };
  return map[val.toLowerCase()] ?? val;
}

// Etiqueta de cada variante: los atributos que la distinguen, o el SKU como fallback
const variantsWithLabel = product.variants.map((v) => {
  const distinguishing = (v.attributes ?? [])
    .filter((a) => diffAttrNames.has(a.name))
    .map((a) => a.value);
  const colorVal = (v.attributes ?? []).find(a => a.name.toLowerCase() === 'color')?.value ?? null;
  return {
    v,
    label: distinguishing.length ? distinguishing.join(' · ') : v.sku,
    colorHex: colorVal ? toColorHex(colorVal) : null,
    colorLabel: colorVal ?? null,
  };
});

// Galería inicial: imágenes de la variante activa si tiene; si no, las del producto
const firstVarImages = product.variants[0]?.images ?? [];
const galleryImages = firstVarImages.length ? firstVarImages : images;
---

<Base title={product.title} description={metaDesc}>
  <article class="detail">
    <nav class="breadcrumb">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/productos">Catálogo</a>
      <span>/</span>
      <span class="current">{product.title}</span>
    </nav>

    <div class="detail-grid">
      <!-- ── Galería ── -->
      <div class="gallery" data-fallback={JSON.stringify(images)}>
        <div class="main-image">
          {galleryImages.length > 0
            ? <img id="main-img" src={galleryImages[0]} alt={product.title} />
            : <div class="no-image">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
                </svg>
              </div>
          }
        </div>
        <div class="thumbs" id="thumbs" hidden={galleryImages.length <= 1}>
          {galleryImages.length > 1 && galleryImages.map((img, i) => (
            <button class:list={['thumb', { active: i === 0 }]} data-src={img} aria-label={`Imagen ${i + 1}`}>
              <img src={img} alt={`${product.title} ${i + 1}`} loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <!-- ── Info ── -->
      <div class="info">
        {product.brand && <p class="brand">{product.brand}</p>}
        <h1 class="title">{product.title}</h1>

        {mainTags.length > 0 && (
          <div class="tags">
            {mainTags.map((t) => <Badge color={t.color}>{t.name}</Badge>)}
          </div>
        )}

        <div class="price-row">
          <span class="price" id="price-display">$ {price.toLocaleString('es-CL')}</span>
          {stock > 0
            ? <Badge variant="success">En stock</Badge>
            : <Badge variant="danger">Sin stock</Badge>
          }
        </div>

        {multiVariant && (
          <div class="variants">
            <div class:list={['variant-list', { 'variant-list--color': isColorVariant }]}>
              {variantsWithLabel.map(({ v, label, colorHex, colorLabel }, i) => (
                <button
                  class:list={['variant', { active: i === 0, 'variant--color': isColorVariant }]}
                  data-id={v.id}
                  data-price={v.price}
                  data-sku={v.sku}
                  data-stock={v.stock}
                  data-images={JSON.stringify(v.images ?? [])}
                  data-attributes={JSON.stringify(v.attributes ?? [])}
                  disabled={v.stock === 0}
                  title={label}
                  aria-label={label}
                >
                  {isColorVariant && colorHex
                    ? <span class="color-swatch" style={`background:${colorHex}`}></span>
                    : label
                  }
                </button>
              ))}
            </div>
            {isColorVariant && <p class="variant-label" id="variant-label">{variantsWithLabel[0]?.label}</p>}
          </div>
        )}

        <div class="actions">
          <div class="qty">
            <button class="qty-btn" id="qty-minus" aria-label="Quitar uno">−</button>
            <span id="qty-value">1</span>
            <button class="qty-btn" id="qty-plus" aria-label="Agregar uno">+</button>
          </div>
          <button
            class="btn-cart"
            id="add-cart"
            disabled={stock === 0}
            data-product-id={product.id}
            data-nombre={product.title}
            data-imagen={images[0] ?? ''}
            data-slug={product.slug ?? ''}
            data-variant-id={product.variants[0]?.id ?? ''}
            data-precio={price}
            data-sku={product.variants[0]?.sku ?? ''}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
            <span id="cart-label">{stock === 0 ? 'Sin stock' : 'Agregar al carrito'}</span>
          </button>
          <button class="btn-wish" id="add-wish" aria-label="Agregar a wishlist">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </svg>
          </button>
        </div>

        {hashTags.length > 0 && (
          <div class="hashtags">
            {hashTags.map((t) => <span class="hashtag" style={`--c: ${t.color}`}>{t.name}</span>)}
          </div>
        )}

        <!-- Atributos de la variante activa — se actualiza por JS al cambiar variante -->
        {(product.variants[0]?.attributes?.length ?? 0) > 0 && (
          <div class="attrs-panel" id="attrs-panel">
            {product.variants[0].attributes.map(a => (
              <div class="attr-row">
                <span class="attr-name">{a.name}</span>
                <span class="attr-value">{a.value}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Descripción larga al fondo -->
    {product.description && (
      <div class="description-full">
        <h2>Descripción</h2>
        <p>{product.description}</p>
      </div>
    )}
  </article>
</Base>

<style>
  .detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .breadcrumb a { color: var(--text-muted); transition: color var(--transition); }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .current { color: var(--text); }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* ── Galería ── */
  .main-image {
    aspect-ratio: 1;
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .main-image img { width: 100%; height: 100%; object-fit: contain; padding: 24px; }
  .no-image { color: var(--text-muted); opacity: 0.4; }

  .thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  /* :global para que apliquen también a las miniaturas que el JS reconstruye al cambiar de variante */
  .thumbs :global(.thumb) {
    width: 70px;
    height: 70px;
    border-radius: var(--radius-sm);
    border: 1.5px solid color-mix(in srgb, var(--text) 10%, transparent);
    background: var(--bg-surface);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    transition: border-color var(--transition);
  }
  .thumbs :global(.thumb img) { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  .thumbs :global(.thumb.active) { border-color: var(--accent); box-shadow: var(--neon-subtle); }

  /* ── Info ── */
  .info { display: flex; flex-direction: column; gap: 14px; }

  .brand {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }
  .title {
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .price-row { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
  .price { font-size: 2rem; font-weight: 800; color: var(--accent); }

  /* ── Variantes ── */
  .variants { display: flex; flex-direction: column; gap: 8px; }
  .variant-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .variant {
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    background: var(--bg-surface);
    color: var(--text);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }
  .variant:hover:not(:disabled) { border-color: var(--accent); }
  .variant.active { border-color: var(--accent); color: var(--accent); box-shadow: var(--neon-subtle); }
  .variant:disabled { opacity: 0.4; cursor: not-allowed; text-decoration: line-through; }

  /* ── Acciones ── */
  .actions { display: flex; align-items: center; gap: 12px; margin-top: 8px; flex-wrap: wrap; }
  .qty {
    display: flex;
    align-items: center;
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .qty-btn {
    width: 38px; height: 42px;
    background: var(--bg-surface);
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
    border: none;
  }
  .qty-btn:hover { background: var(--bg-elevated); }
  #qty-value { min-width: 36px; text-align: center; font-weight: 700; }

  .btn-cart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 180px;
    justify-content: center;
    padding: 13px 24px;
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    transition: filter var(--transition), background var(--transition);
  }
  .btn-cart:hover:not(:disabled) { filter: brightness(1.08); }
  .btn-cart:disabled { background: var(--bg-elevated); color: var(--text-muted); cursor: not-allowed; }
  .btn-cart.added { background: var(--success); color: var(--on-accent); }

  .btn-wish {
    width: 46px; height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .btn-wish:hover, .btn-wish.active { color: var(--danger); border-color: var(--danger); }
  .btn-wish.active svg { fill: var(--danger); }

  .hashtags { display: flex; flex-wrap: wrap; gap: 4px 10px; }
  .hashtag { font-size: 0.78rem; font-weight: 600; color: var(--c, var(--text-muted)); opacity: 0.85; }

  /* ── Swatches de color ── */
  .variant-list--color { gap: 10px; }

  .variant--color {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    padding: 3px;
    background: none;
  }
  .variant--color.active { border-color: var(--accent); box-shadow: var(--neon-subtle); }
  .variant--color:disabled { opacity: 0.35; }

  .color-swatch {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .variant-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Panel de atributos ── */
  .attrs-panel {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
  }

  :global(.attr-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.83rem;
    gap: 12px;
  }
  :global(.attr-name) { color: var(--text-muted); font-weight: 500; }
  :global(.attr-value) { color: var(--text); font-weight: 600; text-align: right; }

  /* ── Descripción al fondo ── */
  .description-full {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  }
  .description-full h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: var(--text); }
  .description-full p { color: var(--text-muted); line-height: 1.8; white-space: pre-line; max-width: 720px; }

  @media (max-width: 768px) {
    .detail-grid { grid-template-columns: 1fr; gap: 24px; }
    .title { font-size: 1.35rem; }
    .price { font-size: 1.6rem; }
  }
</style>

<script>
  import { addToCart } from '../../stores/cart';

  const mainImg   = document.getElementById('main-img') as HTMLImageElement | null;
  const galleryEl = document.querySelector<HTMLElement>('.gallery');
  const thumbsEl  = document.getElementById('thumbs');
  const variants  = Array.from(document.querySelectorAll<HTMLButtonElement>('.variant'));
  const productImages: string[] = JSON.parse(galleryEl?.dataset.fallback ?? '[]');
  const priceEl   = document.getElementById('price-display');
  const qtyValue  = document.getElementById('qty-value');
  const qtyMinus  = document.getElementById('qty-minus');
  const qtyPlus   = document.getElementById('qty-plus');
  const addBtn      = document.getElementById('add-cart') as HTMLButtonElement | null;
  const cartLabel   = document.getElementById('cart-label');
  const wishBtn     = document.getElementById('add-wish');
  const attrsPanel  = document.getElementById('attrs-panel');
  const variantLbl  = document.getElementById('variant-label');

  const fmt = (n: number) => `$ ${n.toLocaleString('es-CL')}`;

  // Datos del producto inyectados desde el frontmatter
  const product = {
    id: addBtn?.dataset.productId ?? '',
    nombre: addBtn?.dataset.nombre ?? '',
    imagen: addBtn?.dataset.imagen ?? '',
    slug: addBtn?.dataset.slug ?? '',
  };

  // Variante seleccionada (la primera por defecto, o la única si no hay selector)
  let selected = {
    id: variants[0]?.dataset.id ?? (addBtn?.dataset.variantId ?? ''),
    price: Number(variants[0]?.dataset.price ?? addBtn?.dataset.precio ?? 0),
    sku: variants[0]?.dataset.sku ?? addBtn?.dataset.sku ?? '',
  };
  let qty = 1;

  // Galería: pinta imagen principal + miniaturas para un set de imágenes
  function renderGallery(imgs: string[]) {
    if (!imgs.length || !mainImg) return;
    mainImg.src = imgs[0];
    if (!thumbsEl) return;
    if (imgs.length > 1) {
      thumbsEl.hidden = false;
      thumbsEl.innerHTML = imgs
        .map((img, i) => `<button class="thumb${i === 0 ? ' active' : ''}" data-src="${img}" aria-label="Imagen ${i + 1}"><img src="${img}" loading="lazy" alt=""></button>`)
        .join('');
    } else {
      thumbsEl.hidden = true;
      thumbsEl.innerHTML = '';
    }
  }

  // Miniaturas (delegación: sobrevive al re-render al cambiar de variante)
  thumbsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.thumb');
    if (!btn || !mainImg) return;
    if (btn.dataset.src) mainImg.src = btn.dataset.src;
    thumbsEl.querySelectorAll('.thumb').forEach((x) => x.classList.remove('active'));
    btn.classList.add('active');
  });

  // Variantes: actualiza precio, selección y galería (imágenes propias o las del producto)
  variants.forEach((v) => {
    v.addEventListener('click', () => {
      variants.forEach((x) => x.classList.remove('active'));
      v.classList.add('active');
      selected = {
        id: v.dataset.id ?? '',
        price: Number(v.dataset.price ?? 0),
        sku: v.dataset.sku ?? '',
      };
      if (priceEl) priceEl.textContent = fmt(selected.price);

      const vImgs: string[] = JSON.parse(v.dataset.images ?? '[]');
      renderGallery(vImgs.length ? vImgs : productImages);

      // Actualizar panel de atributos
      const attrs: { name: string; value: string }[] = JSON.parse(v.dataset.attributes ?? '[]');
      if (attrsPanel && attrs.length) {
        attrsPanel.innerHTML = attrs.map(a =>
          `<div class="attr-row"><span class="attr-name">${a.name}</span><span class="attr-value">${a.value}</span></div>`
        ).join('');
      }

      // Actualizar label de color
      if (variantLbl) variantLbl.textContent = v.title ?? v.getAttribute('aria-label') ?? '';
    });
  });

  // Cantidad
  const renderQty = () => { if (qtyValue) qtyValue.textContent = String(qty); };
  qtyMinus?.addEventListener('click', () => { qty = Math.max(1, qty - 1); renderQty(); });
  qtyPlus?.addEventListener('click', () => { qty += 1; renderQty(); });

  // Agregar al carrito
  addBtn?.addEventListener('click', () => {
    addToCart({
      variantId: selected.id,
      productId: product.id,
      nombre: product.nombre,
      precio: selected.price,
      cantidad: qty,
      imagen: product.imagen,
      slug: product.slug || null,
      sku: selected.sku,
    });
    if (cartLabel) cartLabel.textContent = '✓ Agregado';
    addBtn.classList.add('added');
    setTimeout(() => {
      if (cartLabel) cartLabel.textContent = 'Agregar al carrito';
      addBtn.classList.remove('added');
    }, 1500);
  });

  wishBtn?.addEventListener('click', () => wishBtn.classList.toggle('active'));
</script>
