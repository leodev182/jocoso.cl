---
import Base from '../../layouts/Base.astro';
import RequireAuth from '../../components/auth/RequireAuth.astro';
import AddressForm from '../../components/account/AddressForm.astro';

const MAX = 3;
---

<Base title="Mis direcciones">
  <RequireAuth />
  <section class="addr">
    <div class="addr-head">
      <h1>Mis Direcciones</h1>
      <button class="btn-add" id="btn-add">+ Agregar Dirección</button>
    </div>

    <p class="loading" id="addr-loading">Cargando direcciones…</p>
    <p class="error" id="addr-error" hidden></p>

    <div class="addr-list" id="addr-list"></div>

    <p class="addr-empty" id="addr-empty" hidden>Aún no tienes direcciones guardadas.</p>
    <p class="addr-max" id="addr-max" hidden>Llegaste al máximo de {MAX} direcciones.</p>

    <!-- ── Formulario (componente reutilizable) ── -->
    <div class="card addr-form-wrap" id="addr-form-wrap" hidden>
      <h2>Nueva dirección</h2>
      <AddressForm />
    </div>
  </section>
</Base>

<style>
  .addr { max-width: 900px; margin: 0 auto; padding: 32px 24px; }
  .addr-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .addr-head h1 { font-size: 1.8rem; font-weight: 800; color: var(--text); }

  .btn-add {
    padding: 10px 18px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--on-accent);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: filter var(--transition);
  }
  .btn-add:hover { filter: brightness(1.08); }
  .btn-add[hidden] { display: none; }

  .loading, .addr-empty, .addr-max { color: var(--text-muted); padding: 16px 0; }
  .error { color: var(--danger); background: var(--danger-bg); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; }

  .addr-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }

  .card {
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  :global(.addr-item) {
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.addr-item.is-default) { border-color: color-mix(in srgb, var(--accent) 45%, transparent); box-shadow: var(--neon-subtle); }
  :global(.ai-top) { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  :global(.ai-alias) { font-weight: 800; color: var(--text); font-size: 1rem; }
  :global(.ai-badge) { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--on-accent); background: var(--accent); padding: 2px 8px; border-radius: 4px; }
  :global(.ai-line) { font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; }
  :global(.ai-name) { color: var(--text); font-weight: 600; }
  :global(.ai-actions) { display: flex; gap: 14px; margin-top: 8px; }
  :global(.ai-actions button) { background: none; border: none; font-family: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer; padding: 0; }
  :global(.ai-default) { color: var(--accent); }
  :global(.ai-delete) { color: var(--danger); }

  /* Contenedor del formulario (el form en sí vive en AddressForm) */
  .addr-form-wrap { margin-top: 24px; }
  .addr-form-wrap[hidden] { display: none; }
  .addr-form-wrap h2 { font-size: 1.1rem; font-weight: 800; color: var(--text); margin-bottom: 16px; }
</style>

<script>
  import { getAddresses, setDefaultAddress, deleteAddress, type Address } from '../../lib/api';

  const MAX = 3;
  const $ = (id: string) => document.getElementById(id)!;
  const listEl = $('addr-list');
  const wrap = $('addr-form-wrap');
  const addrForm = document.querySelector<HTMLFormElement>('[data-address-form]')!;
  const globalError = $('addr-error');

  let addresses: Address[] = [];

  function lineFor(a: Address) {
    const calle = `${a.calle} ${a.numero}${a.depto ? `, ${a.depto}` : ''}`;
    return { calle, zona: `${a.comuna}, ${a.ciudad}, ${a.region}` };
  }

  function render() {
    $('addr-loading').hidden = true;
    listEl.innerHTML = '';
    addresses.forEach((a) => {
      const { calle, zona } = lineFor(a);
      const el = document.createElement('div');
      el.className = 'addr-item' + (a.isDefault ? ' is-default' : '');
      el.innerHTML = `
        <div class="ai-top">
          <span class="ai-alias">${a.alias}</span>
          ${a.isDefault ? '<span class="ai-badge">Predeterminada</span>' : ''}
        </div>
        <span class="ai-line ai-name">${a.fullName}</span>
        <span class="ai-line">${calle}</span>
        <span class="ai-line">${zona}</span>
        <span class="ai-line">RUT ${a.rut} · ${a.phone}</span>
        <div class="ai-actions">
          ${a.isDefault ? '' : `<button class="ai-default" data-id="${a.id}">Hacer predeterminada</button>`}
          <button class="ai-delete" data-id="${a.id}">Eliminar</button>
        </div>`;
      listEl.appendChild(el);
    });

    $('addr-empty').hidden = addresses.length > 0;
    $('addr-max').hidden = addresses.length < MAX;
    ($('btn-add') as HTMLButtonElement).hidden = addresses.length >= MAX || !wrap.hidden;
  }

  async function load() {
    try {
      addresses = await getAddresses();
      render();
    } catch (err) {
      $('addr-loading').hidden = true;
      globalError.textContent = err instanceof Error ? err.message : 'Error al cargar';
      globalError.hidden = false;
    }
  }

  // Acciones (delegación)
  listEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-id]');
    if (!btn) return;
    const id = btn.dataset.id!;
    try {
      if (btn.classList.contains('ai-default')) await setDefaultAddress(id);
      else if (btn.classList.contains('ai-delete')) {
        if (!confirm('¿Eliminar esta dirección?')) return;
        await deleteAddress(id);
      }
      await load();
    } catch (err) {
      globalError.textContent = err instanceof Error ? err.message : 'Error';
      globalError.hidden = false;
    }
  });

  // Abrir el formulario (el componente AddressForm pre-llena email/nombre solo)
  $('btn-add').addEventListener('click', () => {
    wrap.hidden = false;
    addrForm.hidden = false;
    ($('btn-add') as HTMLButtonElement).hidden = true;
  });

  // Eventos que emite el AddressForm
  document.addEventListener('address:created', () => { wrap.hidden = true; load(); });
  document.addEventListener('address:cancel', () => { wrap.hidden = true; render(); });

  load();
</script>
