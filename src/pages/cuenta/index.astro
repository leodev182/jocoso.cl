---
import Base from '../../layouts/Base.astro';
import RequireAuth from '../../components/auth/RequireAuth.astro';
---

<Base title="Mi perfil" robots="noindex, nofollow">
  <RequireAuth />
  <section class="profile">
    <h1>Mi Perfil</h1>

    <div class="profile-layout">
      <!-- ── Información personal ── -->
      <div class="card info-card">
        <div class="card-head">
          <h2>Información Personal</h2>
          <button class="btn-edit" id="btn-edit">Editar</button>
        </div>

        <!-- Vista -->
        <div class="fields" id="view-mode">
          <div class="field">
            <span class="label">Nombre</span>
            <span class="value" id="v-name">—</span>
          </div>
          <div class="field">
            <span class="label">Email</span>
            <span class="value" id="v-email">—</span>
          </div>
          <div class="field">
            <span class="label">Teléfono</span>
            <span class="value" id="v-phone">Sin teléfono</span>
          </div>
        </div>

        <!-- Edición -->
        <form class="fields" id="edit-mode" hidden>
          <label class="field">
            <span class="label">Nombre</span>
            <input class="input" id="i-name" type="text" placeholder="Tu nombre" />
          </label>
          <div class="field">
            <span class="label">Email</span>
            <span class="value readonly" id="i-email">—</span>
            <span class="hint">El email viene de tu cuenta de Google y no se puede cambiar.</span>
          </div>
          <label class="field">
            <span class="label">Teléfono</span>
            <input class="input" id="i-phone" type="tel" placeholder="+56 9 1234 5678" />
          </label>
          <p class="error" id="edit-error" hidden></p>
          <div class="edit-actions">
            <button type="submit" class="btn-save" id="btn-save">Guardar</button>
            <button type="button" class="btn-cancel" id="btn-cancel">Cancelar</button>
          </div>
        </form>
      </div>

      <!-- ── Columna derecha ── -->
      <aside class="profile-side">
        <div class="card">
          <h2>Accesos Rápidos</h2>
          <nav class="quick-nav">
            <a href="/cuenta/pedidos">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
              Mis Pedidos
            </a>
            <a href="/cuenta/direcciones">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Mis Direcciones
            </a>
            <a href="/cuenta/favoritos">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              Mis Favoritos
            </a>
            <button class="logout-row" id="logout">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Cerrar Sesión
            </button>
          </nav>
        </div>

        <div class="card">
          <h2>Información de Cuenta</h2>
          <p class="acc-row">Rol: <strong id="acc-role">—</strong></p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .profile { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
  .profile h1 { font-size: 1.8rem; font-weight: 800; color: var(--text); margin-bottom: 24px; }

  .profile-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
    align-items: start;
  }

  .card {
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .card h2 { font-size: 1.15rem; font-weight: 800; color: var(--text); }

  .card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .btn-edit {
    padding: 7px 16px;
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }
  .btn-edit:hover { border-color: var(--accent); color: var(--accent); }

  .fields { display: flex; flex-direction: column; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .label { font-size: 0.8rem; color: var(--text-muted); }
  .value { font-size: 1rem; font-weight: 700; color: var(--text); }
  .value.readonly { opacity: 0.7; font-weight: 600; }
  .hint { font-size: 0.72rem; color: var(--text-muted); }

  .input {
    background: var(--bg-elevated);
    border: 1.5px solid color-mix(in srgb, var(--text) 12%, transparent);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.92rem;
    outline: none;
    transition: border-color var(--transition);
  }
  .input:focus { border-color: var(--accent); }

  .edit-actions { display: flex; gap: 10px; margin-top: 4px; }
  .btn-save {
    padding: 10px 22px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: filter var(--transition);
  }
  .btn-save:hover { filter: brightness(1.08); }
  .btn-save:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-cancel {
    padding: 10px 18px;
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-muted);
    font-family: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .error { font-size: 0.82rem; color: var(--danger); }

  /* ── Columna derecha ── */
  .profile-side { display: flex; flex-direction: column; gap: 16px; }
  .profile-side .card h2 { margin-bottom: 14px; }

  .quick-nav { display: flex; flex-direction: column; gap: 6px; }
  .quick-nav a, .logout-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    background: none;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
    transition: border-color var(--transition), background var(--transition);
  }
  .quick-nav a:hover, .logout-row:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }
  .logout-row { color: var(--danger); }
  .logout-row:hover { border-color: color-mix(in srgb, var(--danger) 45%, transparent); background: var(--danger-bg); }

  .acc-row { font-size: 0.9rem; color: var(--text-muted); }
  .acc-row strong { color: var(--text); }

  @media (max-width: 860px) {
    .profile-layout { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initAuth, userStore, updateUser, clearAuth } from '../../stores/auth';
  import { updateProfile } from '../../lib/api';

  const ROLE_LABEL: Record<string, string> = {
    CUSTOMER: 'Cliente',
    ADMIN: 'Administrador',
    SUPPORT: 'Soporte',
  };

  initAuth();

  const $ = (id: string) => document.getElementById(id)!;
  const viewMode = $('view-mode');
  const editMode = $('edit-mode') as HTMLFormElement;
  const errorEl  = $('edit-error');

  function renderView() {
    const u = userStore.get();
    if (!u) return;
    $('v-name').textContent  = u.name ?? '—';
    $('v-email').textContent = u.email;
    $('v-phone').textContent = u.phone ?? 'Sin teléfono';
    $('acc-role').textContent = ROLE_LABEL[u.role] ?? u.role;
  }

  function enterEdit() {
    const u = userStore.get();
    if (!u) return;
    (($('i-name') as HTMLInputElement)).value = u.name ?? '';
    (($('i-phone') as HTMLInputElement)).value = u.phone ?? '';
    $('i-email').textContent = u.email;
    errorEl.hidden = true;
    viewMode.hidden = true;
    editMode.hidden = false;
    $('btn-edit').hidden = true;
  }

  function exitEdit() {
    editMode.hidden = true;
    viewMode.hidden = false;
    $('btn-edit').hidden = false;
  }

  renderView();
  $('btn-edit').addEventListener('click', enterEdit);
  $('btn-cancel').addEventListener('click', exitEdit);

  editMode.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name  = (($('i-name') as HTMLInputElement)).value.trim() || null;
    const phone = (($('i-phone') as HTMLInputElement)).value.trim() || null;
    const saveBtn = $('btn-save') as HTMLButtonElement;

    saveBtn.disabled = true;
    errorEl.hidden = true;
    try {
      await updateProfile({ name, phone });
      updateUser({ name, phone });
      renderView();
      exitEdit();
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'No se pudo guardar';
      errorEl.hidden = false;
    } finally {
      saveBtn.disabled = false;
    }
  });

  $('logout').addEventListener('click', () => {
    clearAuth();
    location.href = '/';
  });
</script>
