---
import Base from '../layouts/Base.astro';
import RequireAuth from '../components/auth/RequireAuth.astro';
---

<Base title="Carrito">
  <RequireAuth />
  <section class="cart">
    <h1 class="cart-title">Tu carrito</h1>
    <div id="cart-root"></div>
  </section>
</Base>

<!-- Plantilla del carrito con items -->
<template id="tpl-filled">
  <div class="cart-layout">
    <div class="cart-items" id="cart-items"></div>
    <aside class="cart-summary">
      <h2>Resumen</h2>
      <div class="summary-row">
        <span>Subtotal</span>
        <span id="sum-subtotal"></span>
      </div>
      <div class="summary-row muted">
        <span>Envío</span>
        <span>Se calcula al pagar</span>
      </div>
      <div class="summary-row total">
        <span>Total</span>
        <span id="sum-total"></span>
      </div>
      <a href="/checkout" class="btn-checkout">Finalizar compra</a>
      <a href="/productos" class="link-keep">← Seguir comprando</a>
    </aside>
  </div>
</template>

<!-- Plantilla carrito vacío -->
<template id="tpl-empty">
  <div class="cart-empty">
    <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
    </svg>
    <p>Tu carrito está vacío</p>
    <a href="/productos" class="btn-checkout">Ver productos</a>
  </div>
</template>

<style>
  .cart {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px;
  }
  .cart-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 24px;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 24px;
    align-items: start;
  }

  /* ── Items ── */
  .cart-items { display: flex; flex-direction: column; gap: 12px; }

  :global(.cart-item) {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    gap: 16px;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 7%, transparent);
    border-radius: var(--radius-md);
    padding: 12px;
  }
  :global(.ci-image) {
    width: 88px; height: 88px;
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }
  :global(.ci-image img) { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  :global(.ci-info) { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  :global(.ci-name) {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.ci-name:hover) { color: var(--accent); }
  :global(.ci-sku) { font-size: 0.72rem; color: var(--text-muted); }
  :global(.ci-unit) { font-size: 0.82rem; color: var(--text-muted); }

  :global(.ci-right) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  :global(.ci-line) { font-size: 1rem; font-weight: 800; color: var(--accent); white-space: nowrap; }

  :global(.ci-qty) {
    display: flex;
    align-items: center;
    border: 1.5px solid color-mix(in srgb, var(--text) 15%, transparent);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  :global(.ci-qty button) {
    width: 30px; height: 32px;
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1.05rem;
    cursor: pointer;
    border: none;
  }
  :global(.ci-qty button:hover) { background: var(--bg-brand); }
  :global(.ci-qty span) { min-width: 30px; text-align: center; font-weight: 700; font-size: 0.85rem; }

  :global(.ci-remove) {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition);
  }
  :global(.ci-remove:hover) { color: var(--danger); }

  /* ── Resumen ── */
  .cart-summary {
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius-md);
    padding: 20px;
    position: sticky;
    top: calc(var(--header-height) + 16px);
  }
  .cart-summary h2 { font-size: 1.05rem; font-weight: 800; margin-bottom: 16px; color: var(--text); }
  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    font-size: 0.9rem;
    color: var(--text);
  }
  .summary-row.muted { color: var(--text-muted); font-size: 0.82rem; }
  .summary-row.total {
    border-top: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    margin-top: 8px;
    padding-top: 14px;
    font-size: 1.1rem;
    font-weight: 800;
  }
  .summary-row.total span:last-child { color: var(--accent); }

  .btn-checkout {
    display: block;
    text-align: center;
    margin-top: 16px;
    padding: 13px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: filter var(--transition);
  }
  .btn-checkout:hover { filter: brightness(1.08); }
  .link-keep {
    display: block;
    text-align: center;
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .link-keep:hover { color: var(--accent); }

  /* ── Vacío ── */
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 64px 0;
    color: var(--text-muted);
    text-align: center;
  }
  .cart-empty p { font-size: 1.05rem; }
  .cart-empty .btn-checkout { display: inline-block; padding: 11px 28px; }

  @media (max-width: 768px) {
    .cart-layout { grid-template-columns: 1fr; }
    .cart-summary { position: static; }
  }
</style>

<script>
  import { cartStore, initCart, updateQuantity, removeFromCart, cartTotal, type CartItem } from '../stores/cart';

  const root = document.getElementById('cart-root')!;
  const tplFilled = document.getElementById('tpl-filled') as HTMLTemplateElement;
  const tplEmpty  = document.getElementById('tpl-empty') as HTMLTemplateElement;

  const fmt = (n: number) => `$ ${n.toLocaleString('es-CL')}`;
  const hrefFor = (i: CartItem) => `/productos/${i.slug ?? i.productId}`;

  function itemNode(i: CartItem): HTMLElement {
    const el = document.createElement('div');
    el.className = 'cart-item';
    el.dataset.variant = i.variantId;
    el.innerHTML = `
      <a class="ci-image" href="${hrefFor(i)}">
        ${i.imagen ? `<img src="${i.imagen}" alt="${i.nombre}">` : ''}
      </a>
      <div class="ci-info">
        <a class="ci-name" href="${hrefFor(i)}">${i.nombre}</a>
        ${i.sku ? `<span class="ci-sku">${i.sku}</span>` : ''}
        <span class="ci-unit">${fmt(i.precio)} c/u</span>
      </div>
      <div class="ci-right">
        <span class="ci-line">${fmt(i.precio * i.cantidad)}</span>
        <div class="ci-qty">
          <button data-act="dec" aria-label="Quitar uno">−</button>
          <span>${i.cantidad}</span>
          <button data-act="inc" aria-label="Agregar uno">+</button>
        </div>
        <button class="ci-remove" data-act="remove">Eliminar</button>
      </div>`;
    return el;
  }

  function render() {
    const items = cartStore.get();
    root.innerHTML = '';

    if (items.length === 0) {
      root.appendChild(tplEmpty.content.cloneNode(true));
      return;
    }

    root.appendChild(tplFilled.content.cloneNode(true));
    const list = document.getElementById('cart-items')!;
    items.forEach((i) => list.appendChild(itemNode(i)));

    const subtotal = cartTotal();
    document.getElementById('sum-subtotal')!.textContent = fmt(subtotal);
    document.getElementById('sum-total')!.textContent = fmt(subtotal);

    // Acciones por item (delegación)
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      if (!btn) return;
      const row = btn.closest<HTMLElement>('.cart-item');
      const variantId = row?.dataset.variant;
      if (!variantId) return;
      const current = cartStore.get().find((x) => x.variantId === variantId);
      if (!current) return;

      if (btn.dataset.act === 'inc') updateQuantity(variantId, current.cantidad + 1);
      else if (btn.dataset.act === 'dec') updateQuantity(variantId, current.cantidad - 1);
      else if (btn.dataset.act === 'remove') removeFromCart(variantId);
    });
  }

  initCart();
  render();
  cartStore.subscribe(() => render());
</script>
