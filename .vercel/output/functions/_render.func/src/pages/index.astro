---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import ProductSection from '../components/products/ProductSection.astro';
import FeaturedSection from '../components/products/FeaturedSection.astro';
import DarkflashGrid from '../components/products/DarkflashGrid.astro';
import GlassPills from '../components/layout/GlassPills.astro';
import { getStorefrontProducts } from '../lib/api';

const SECTION_LIMIT = 12;

// Secciones: Destacados, Darkflash, y "ventilacion" mostrado como "Refrigeración"
const [featured, darkflash, refrigeracion] = await Promise.all([
  getStorefrontProducts({ featured: true, limit: SECTION_LIMIT }),
  getStorefrontProducts({ tag: 'darkflash', limit: SECTION_LIMIT }),
  getStorefrontProducts({ tag: 'ventilacion', limit: SECTION_LIMIT }),
]);
---

<Base title="Inicio">
  <Hero />

  <FeaturedSection products={featured.data} />

  <DarkflashGrid products={darkflash.data} />

  <GlassPills />

  {refrigeracion.data.length > 0 && (
    <ProductSection
      title="Refrigeración"
      viewAllHref="/productos?tag=ventilacion"
      products={refrigeracion.data}
      titleGradient="linear-gradient(135deg, #f97316 0%, #fb923c 50%, #fbbf24 100%)"
    />
  )}
</Base>
